#!/usr/bin/env bash
# .git/hooks/pre-push
#
# Automatically posts a comment to the open PR (if any) for the current branch
# whenever `git push` is run, listing the commits about to be pushed.
#
# Runs BEFORE the push so comments are posted even if the remote rejects.
# If gh CLI is unavailable or no PR exists, exits cleanly without blocking.
#
# Install (from repo root):
#   cp .github/hooks/scripts/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push

set -euo pipefail

REMOTE="$1"
# REMOTE_URL="$2"  # available but not needed

# ── 1. Bail silently if gh is not installed ───────────────────────────────────
if ! command -v gh &>/dev/null; then
    exit 0
fi

# ── 2. Current branch ────────────────────────────────────────────────────────
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [[ -z "$BRANCH" || "$BRANCH" == "HEAD" ]]; then
    exit 0
fi

# ── 3. Find open PR for this branch ──────────────────────────────────────────
PR_JSON=$(gh pr list --head "$BRANCH" --state open --json number,title --limit 1 2>/dev/null || true)
if [[ -z "$PR_JSON" || "$PR_JSON" == "[]" ]]; then
    exit 0
fi

PR_NUMBER=$(echo "$PR_JSON" | grep -o '"number":[0-9]*' | head -1 | grep -o '[0-9]*')
PR_TITLE=$(echo "$PR_JSON"  | sed 's/.*"title":"\([^"]*\)".*/\1/')

if [[ -z "$PR_NUMBER" ]]; then
    exit 0
fi

# ── 4. Collect commits being pushed (stdin from git) ─────────────────────────
# pre-push stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>
COMMIT_LINES=""
PUSH_COUNT=0

while IFS=' ' read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [[ "$LOCAL_SHA" == "0000000000000000000000000000000000000000" ]]; then
        continue  # branch deletion — skip
    fi
    if [[ "$REMOTE_SHA" == "0000000000000000000000000000000000000000" ]]; then
        # New branch — show last 10 commits
        LOG=$(git log -10 "$LOCAL_SHA" --oneline --no-merges 2>/dev/null || true)
        RANGE_DESC="new branch"
    else
        LOG=$(git log "${REMOTE_SHA}..${LOCAL_SHA}" --oneline --no-merges 2>/dev/null || true)
        RANGE_DESC="${REMOTE_SHA:0:7}..${LOCAL_SHA:0:7}"
    fi
    if [[ -n "$LOG" ]]; then
        COMMIT_LINES+="$LOG"$'\n'
        PUSH_COUNT=$(( PUSH_COUNT + $(echo "$LOG" | wc -l) ))
    fi
done

if [[ -z "$COMMIT_LINES" || "$PUSH_COUNT" -eq 0 ]]; then
    exit 0
fi

COMMIT_LIST=$(echo "$COMMIT_LINES" | grep -v '^$' | sed 's/^/- `/' | sed 's/$/`/')
PLURAL=$([ "$PUSH_COUNT" -eq 1 ] && echo "commit" || echo "commits")
BODY="**${PUSH_COUNT} ${PLURAL} pushed** to \`${BRANCH}\` (${RANGE_DESC})"$'\n\n'"${COMMIT_LIST}"$'\n\n'"*Posted automatically by pre-push hook*"

# ── 6. Reply to open review threads, or post standalone if none ───────────────
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
OWNER=${REPO%%/*}
REPONAME=${REPO##*/}
PR_URL="https://github.com/${REPO}/pull/${PR_NUMBER}"

# Query unresolved review threads via GraphQL
THREADS_FILE=$(mktemp /tmp/pr-threads-XXXXXX.json)
gh api graphql \
    -F owner="$OWNER" -F repo="$REPONAME" -F number="$PR_NUMBER" \
    -f query='query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){pullRequest(number:$number){reviewThreads(first:50){nodes{id isResolved comments(first:1){nodes{databaseId}}}}}}}' \
    > "$THREADS_FILE" 2>/dev/null || echo '{"data":null}' > "$THREADS_FILE"

THREAD_COUNT=$(node -e "
const fs=require('fs');
const d=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));
const n=(d.data?.repository?.pullRequest?.reviewThreads?.nodes||[])
  .filter(t=>!t.isResolved&&t.comments.nodes.length>0).length;
process.stdout.write(String(n));
" "$THREADS_FILE" 2>/dev/null || echo "0")

echo "pre-push: PR #${PR_NUMBER} — ${THREAD_COUNT} unresolved review thread(s)…" >&2

# Encode body as JSON for REST API (replies endpoint)
REPLY_JSON=$(mktemp /tmp/pr-reply-XXXXXX.json)
node -e "process.stdout.write(JSON.stringify({body:process.argv[1]}))" "$BODY" > "$REPLY_JSON" 2>/dev/null || \
    { ESCAPED=$(printf '%s' "$BODY" | sed 's/\\/\\\\/g; s/"/\\"/g'); printf '{"body":"%s"}' "$ESCAPED" > "$REPLY_JSON"; }

# Plain-text body for standalone comment fallback
REPLY_TXT=$(mktemp /tmp/pr-reply-XXXXXX.md)
printf '%s' "$BODY" > "$REPLY_TXT"

if [[ "${THREAD_COUNT:-0}" -gt 0 ]]; then
    RESOLVED=0
    while IFS=$'\t' read -r THREAD_ID COMMENT_DB_ID; do
        # Reply to the thread's root comment
        gh api "/repos/${REPO}/pulls/${PR_NUMBER}/comments/${COMMENT_DB_ID}/replies" \
            --method POST --input "$REPLY_JSON" >/dev/null 2>&1 || true
        # Mark the thread resolved
        gh api graphql \
            -F threadId="$THREAD_ID" \
            -f query='mutation($threadId:ID!){resolveReviewThread(input:{threadId:$threadId}){thread{isResolved}}}' \
            >/dev/null 2>&1 || true
        RESOLVED=$(( RESOLVED + 1 ))
    done < <(node -e "
const fs=require('fs');
const d=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));
(d.data?.repository?.pullRequest?.reviewThreads?.nodes||[])
  .filter(t=>!t.isResolved&&t.comments.nodes.length>0)
  .forEach(t=>console.log(t.id+'\t'+t.comments.nodes[0].databaseId));
" "$THREADS_FILE" 2>/dev/null || true)

    rm -f "$REPLY_JSON" "$REPLY_TXT" "$THREADS_FILE"
    echo "" >&2
    echo "  ✔ ${RESOLVED} review thread(s) replied to and resolved" >&2
    echo "  → ${PR_URL}" >&2
    echo "" >&2
else
    # No open review threads — post as a standalone push summary comment
    gh pr comment "$PR_NUMBER" --body-file "$REPLY_TXT" >/dev/null 2>&1 || true
    rm -f "$REPLY_JSON" "$REPLY_TXT" "$THREADS_FILE"
    echo "" >&2
    echo "  ✔ PR comment posted (no open review threads)" >&2
    echo "  → ${PR_URL}" >&2
    echo "" >&2
fi

exit 0
